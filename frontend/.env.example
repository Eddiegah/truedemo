# Neon Postgres connection string - free tier, no card: https://neon.tech
DATABASE_URL=

# A GitHub fine-grained personal access token with "Actions: write" permission
# on the truedemo repo - used to trigger the worker via workflow_dispatch.
# https://github.com/settings/personal-access-tokens/new
GH_DISPATCH_TOKEN=

# owner/repo the workflow lives in
GITHUB_REPO=Eddiegah/truedemo

# Shared secret the worker (GitHub Actions runner) must present when POSTing
# progress updates back to /api/jobs/[id]/progress - generate any long
# random string, and set the SAME value as a GitHub Actions secret named
# WEBHOOK_SECRET on the repo.
WEBHOOK_SECRET=
